# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Database & Auth Configuration
# Get these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Firebase Client Configuration (Optional alternative)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="prana-wellness.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="prana-wellness"
VITE_FIREBASE_STORAGE_BUCKET="prana-wellness.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcd1234efgh"

# Payment Gateway Configuration (India - Razorpay)
VITE_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
